---
import ExperienceItem from "./ExperienceItem.astro"
import { getLocale, useTranslations } from "@/i18n"

const locale = getLocale(Astro.url)
const t = useTranslations(locale)
const EXPERIENCE = t.experience.items
---

<ol class="relative">
  {
    EXPERIENCE.map((experience) => (
      <li class="">
        <ExperienceItem {...experience} seeMore={t.common.buttons.seeMore} seeLess={t.common.buttons.seeLess} learnMore={t.common.buttons.learnMore} />
      </li>
    ))
  }
</ol>

<script is:inline data-i18n-experience>
  function bindExperienceToggles() {
    document
      .querySelectorAll('.description-toggle')
      .forEach((btn) => {
        if (btn.dataset.bound === 'true') return
        const clamp = btn.previousElementSibling
        if (!clamp) return

        if (clamp.scrollHeight <= clamp.clientHeight + 1) return
        btn.hidden = false
        btn.dataset.bound = 'true'

        const seeMore = btn.dataset.seeMore || 'Ver más'
        const seeLess = btn.dataset.seeLess || 'Ver menos'

        btn.addEventListener('click', () => {
          const isOpen = btn.dataset.state === 'open'
          clamp.classList.toggle('line-clamp-3', isOpen)
          btn.dataset.state = isOpen ? 'closed' : 'open'
          btn.textContent = isOpen ? seeMore : seeLess
        })
      })
  }

  document.addEventListener('astro:page-load', bindExperienceToggles)
  document.addEventListener('astro:after-swap', bindExperienceToggles)
</script>
